ENVIRONMENT=production
DATA_DIR=/data
ORIGIN_BIND=127.0.0.1
APP_CPU_LIMIT=1.5
APP_MEMORY_LIMIT=1g
APP_SECRET=replace-with-at-least-32-random-characters
